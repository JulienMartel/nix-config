#!/usr/bin/env bash
# from-things — import Things 3 into the tracker vault. Reads the app's SQLite
# -readonly (never writes it); writes one markdown note per to-do, one folder
# per project or area, one folder note per folder. Re-runnable: a note whose
# `things:` uuid already exists is skipped, so a second pass only adds what is
# new in Things.
#
#   from-things                 # open items → their project / area folder
#   from-things --logged        # open items, plus the Logbook → log/
#   from-things --logged-only   # the Logbook alone
#   DRY_RUN=1 from-things …     # print what would be written, touch nothing
#
# A logged note is shaped exactly as `tracker complete` would leave it: in
# log/, `status: done|canceled`, `done:` the day Things stopped it, `project:`
# the folder its list would be — stamped even when that folder does not exist,
# because a list can be finished and gone from Things while its history is
# still worth keeping.

set -euo pipefail
here="$(cd "$(dirname "$0")" && pwd)"
# shellcheck source=tracker
source "$here/tracker" --lib          # ROOT, sanitize, yaml_str, folder_note, die

die() { printf 'from-things: %s\n' "$*" >&2; exit 1; }

do_open=1; do_logged=0
for a in "$@"; do
  case "$a" in
    --logged)      do_logged=1 ;;
    --logged-only) do_logged=1; do_open=0 ;;
    -h|--help)     sed -n '2,17p' "$0"; exit 0 ;;
    *)             die "unknown flag $a" ;;
  esac
done

find_db() {
  local d
  for d in "$HOME/Library/Group Containers/JLMPQHK86H.com.culturedcode.ThingsMac"/ThingsData-*/"Things Database.thingsdatabase/main.sqlite"; do
    [ -f "$d" ] && { printf '%s' "$d"; return 0; }
  done
  die "no Things database found"
}
DB="${THINGS_DB:-$(find_db)}"
q() { sqlite3 -readonly -json "$DB" "$1"; }
SEP=$'\x1f'                            # jq joins the columns on it, read splits on it
JOIN='join("\u001f")'

# Things packs dates as bitfields: year<<16 | month<<12 | day<<7.
D() { echo "printf('%04d-%02d-%02d', $1>>16, ($1>>12)&15, ($1>>7)&31)"; }

OPEN="t.status=0 and t.trashed=0"
# Things ships four sample projects with the app. Their to-dos are Cultured
# Code's onboarding copy, not the user's history, so the Logbook pass drops them.
SAMPLES="'Meet Things for Mac','Meet Things for iPhone','Convert to project','new project!!!'"
mkdir -p "$ROOT"

# Every `things:` uuid already in the vault, read once — the dedupe is a lookup,
# not a tree-wide grep per item, because the Logbook pass asks it ~900 times.
SEEN="$(mktemp)"; trap 'rm -f "$SEEN"' EXIT
grep -rh --include='*.md' '^things: ' "$ROOT" 2>/dev/null | sed 's/^things: //' | sort -u > "$SEEN" || true
have() { grep -qxF "$1" "$SEEN"; }

write() {  # write <path> <content> <uuid>  (honours DRY_RUN)
  printf '%s\n' "$3" >> "$SEEN"
  if [ "${DRY_RUN:-0}" = 1 ]; then printf -- '--- %s\n' "${1#"$ROOT/"}"; return; fi
  mkdir -p "$(dirname "$1")"; printf '%s' "$2" > "$1"
}
# A free path for <name> in <dir>, disambiguating a repeated title with (2), (3)…
unique() {
  local dir="$1" name="$2" path="$1/$2.md" i=2
  while [ -e "$path" ]; do path="$dir/$name ($i).md"; i=$((i+1)); done
  printf '%s' "$path"
}
# A `tags:` block, or nothing.
tag_block() {
  [ -n "$1" ] || return 0
  local tg ts; printf '\ntags:'
  IFS=',' read -ra ts <<< "$1"
  for tg in "${ts[@]}"; do printf '\n  - %s' "$(sanitize_tag "$tg")"; done
}
# The checklist of one to-do, as markdown boxes.
checklist() {
  sqlite3 -readonly -noheader "$DB" "select (case status when 0 then '- [ ] ' else '- [x] ' end) || title from TMChecklistItem where task='$1' order by \"index\";"
}

n_proj=0; n_todo=0; n_skip=0; n_log=0; n_empty=0; area_seen=""

# ---------------------------------------------------------------- projects ---
if [ "$do_open" = 1 ]; then
while IFS="$SEP" read -r uuid title area deadline created notes64; do
  folder="$(sanitize "$title")"
  have "$uuid" && continue
  body="$(printf '%s' "$notes64" | base64 -d)"
  fm="---
type: project"
  [ -n "$area" ]     && fm+=$'\n'"area: $(yaml_str "$area")"
  [ -n "$deadline" ] && fm+=$'\n'"deadline: $deadline"
  fm+=$'\n'"created: $created"$'\n'"things: $uuid"$'\n'"---"
  write "$ROOT/$folder/$folder.md" "$fm"$'\n'"${body:+$body

}$(folder_note)" "$uuid"
  n_proj=$((n_proj+1))
done < <(q "select t.uuid, t.title, ifnull(a.title,'') as area,
  (case when t.deadline is null then '' else $(D t.deadline) end) as deadline,
  date(t.creationDate,'unixepoch','localtime') as created, ifnull(t.notes,'') as notes
  from TMTask t left join TMArea a on a.uuid=t.area where t.type=1 and $OPEN order by t.\"index\";" \
  | jq -r ".[] | [.uuid, .title, .area, .deadline, .created, (.notes|@base64)] | map(tostring) | $JOIN")

# ------------------------------------------------------------------- to-dos ---
while IFS="$SEP" read -r uuid title start bucket when deadline created tags project area heading notes64; do
  if have "$uuid"; then n_skip=$((n_skip+1)); continue; fi
  if   [ -n "$project" ]; then folder="$(sanitize "$project")"
  elif [ -n "$area" ];    then folder="$(sanitize "$area")"; area_seen+="$folder"$'\n'
  else folder="inbox"; fi
  name="$(sanitize "$title")"; [ ${#name} -gt 120 ] && name="${name:0:120}"

  # A date means scheduled, whatever list it sits in; Someday is only the undated kind.
  status=open; [ "$start" = 2 ] && [ -z "$when" ] && status=someday
  fm="---
type: todo
status: $status"
  [ "$name" != "$title" ]                   && fm+=$'\n'"title: $(yaml_str "$title")"
  [ -n "$when" ]                            && fm+=$'\n'"when: $when"
  [ "$bucket" = 1 ]                         && fm+=$'\n'"evening: true"
  [ -n "$deadline" ]                        && fm+=$'\n'"deadline: $deadline"
  [ -n "$heading" ]                         && fm+=$'\n'"heading: $(yaml_str "$heading")"
  fm+="$(tag_block "$tags")"
  fm+=$'\n'"created: $created"$'\n'"things: $uuid"$'\n'"---"

  body="$(printf '%s' "$notes64" | base64 -d)"
  check="$(checklist "$uuid")"
  content="$fm"$'\n'
  [ -n "$body" ]  && content+="$body"$'\n'
  [ -n "$check" ] && content+=$'\n'"$check"$'\n'
  write "$(unique "$ROOT/$folder" "$name")" "$content" "$uuid"
  n_todo=$((n_todo+1))
done < <(q "select t.uuid, t.title, t.start, ifnull(t.startBucket,0) as bucket,
  (case when t.startDate is null then '' else $(D t.startDate) end) as \"when\",
  (case when t.deadline  is null then '' else $(D t.deadline)  end) as deadline,
  date(t.creationDate,'unixepoch','localtime') as created,
  ifnull((select group_concat(g.title,',') from TMTaskTag tt join TMTag g on g.uuid=tt.tags where tt.tasks=t.uuid),'') as tags,
  ifnull(p.title,'') as project, ifnull(a.title, ifnull(pa.title,'')) as area, ifnull(h.title,'') as heading,
  ifnull(t.notes,'') as notes
  from TMTask t
    left join TMTask h  on h.uuid  = t.heading
    left join TMTask p  on p.uuid  = coalesce(t.project, h.project)
    left join TMArea a  on a.uuid  = t.area
    left join TMArea pa on pa.uuid = p.area
  where t.type=0 and $OPEN and (p.uuid is null or (p.status=0 and p.trashed=0)) order by t.\"index\";" \
  | jq -r ".[] | [.uuid, .title, .start, .bucket, .when, .deadline, .created, .tags, .project, .area, .heading, (.notes|@base64)] | map(tostring) | $JOIN")

# A folder note for every area that holds loose to-dos, so `tracker projects` and
# Obsidian both have somewhere to stand.
while IFS= read -r folder; do
  [ -n "$folder" ] || continue
  [ -e "$ROOT/$folder/$folder.md" ] && continue
  write "$ROOT/$folder/$folder.md" "---
type: area
---
$(folder_note)" "-"
done < <(printf '%s' "$area_seen" | sort -u)
fi

# ------------------------------------------------------------------ logbook ---
# Everything Things has stopped — done or canceled — flat in log/, whatever list
# it came from and whether or not that list still exists. The project or area a
# to-do sat in survives as the `project:` stamp; nothing here makes a folder.
if [ "$do_logged" = 1 ]; then
mkdir -p "$ROOT/log"
while IFS="$SEP" read -r uuid title tstatus when deadline created done tags project area heading notes64; do
  if have "$uuid"; then n_skip=$((n_skip+1)); continue; fi
  body="$(printf '%s' "$notes64" | base64 -d)"
  check="$(checklist "$uuid")"
  name="$(sanitize "$title")"; [ ${#name} -gt 120 ] && name="${name:0:120}"
  if [ -z "$name" ]; then               # a blank to-do: keep it only if it says something
    name="$(sanitize "$(printf '%s' "$body" | head -1)")"; name="${name:0:120}"
    [ -n "$name" ] || [ -n "$check" ] || { n_empty=$((n_empty+1)); continue; }
    [ -n "$name" ] || name="untitled"
  fi

  if   [ -n "$project" ]; then stamp="$(sanitize "$project")"
  elif [ -n "$area" ];    then stamp="$(sanitize "$area")"
  else stamp=""; fi

  status=done; [ "$tstatus" = 2 ] && status=canceled
  fm="---
type: todo
status: $status"
  [ -n "$title" ] && [ "$name" != "$title" ] && fm+=$'\n'"title: $(yaml_str "$title")"
  [ -n "$when" ]     && fm+=$'\n'"when: $when"
  [ -n "$deadline" ] && fm+=$'\n'"deadline: $deadline"
  [ -n "$heading" ]  && fm+=$'\n'"heading: $(yaml_str "$heading")"
  fm+="$(tag_block "$tags")"
  fm+=$'\n'"created: $created"$'\n'"done: $done"
  [ -n "$stamp" ]    && fm+=$'\n'"project: $(yaml_str "$stamp")"
  fm+=$'\n'"things: $uuid"$'\n'"---"

  content="$fm"$'\n'
  [ -n "$body" ]  && content+="$body"$'\n'
  [ -n "$check" ] && content+=$'\n'"$check"$'\n'
  write "$(unique "$ROOT/log" "$name")" "$content" "$uuid"
  n_log=$((n_log+1))
done < <(q "select t.uuid, t.title, t.status,
  (case when t.startDate is null then '' else $(D t.startDate) end) as \"when\",
  (case when t.deadline  is null then '' else $(D t.deadline)  end) as deadline,
  date(t.creationDate,'unixepoch','localtime') as created,
  date(t.stopDate,'unixepoch','localtime') as done,
  ifnull((select group_concat(g.title,',') from TMTaskTag tt join TMTag g on g.uuid=tt.tags where tt.tasks=t.uuid),'') as tags,
  ifnull(p.title,'') as project, ifnull(a.title, ifnull(pa.title,'')) as area, ifnull(h.title,'') as heading,
  ifnull(t.notes,'') as notes
  from TMTask t
    left join TMTask h  on h.uuid  = t.heading
    left join TMTask p  on p.uuid  = coalesce(t.project, h.project)
    left join TMArea a  on a.uuid  = t.area
    left join TMArea pa on pa.uuid = p.area
  where t.type=0 and t.trashed=0 and t.status in (2,3)
    and ifnull(p.title,'') not in ($SAMPLES) order by t.stopDate;" \
  | jq -r ".[] | [.uuid, .title, .status, .when, .deadline, .created, .done, .tags, .project, .area, .heading, (.notes|@base64)] | map(tostring) | $JOIN")
fi

mkdir -p "$ROOT/inbox" "$ROOT/log"
printf 'from-things: %d project(s), %d to-do(s), %d logged written; %d already there' \
  "$n_proj" "$n_todo" "$n_log" "$n_skip"
[ "$n_empty" -gt 0 ] && printf ', %d blank skipped' "$n_empty"
printf ' → %s\n' "$ROOT"
