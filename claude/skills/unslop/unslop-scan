#!/usr/bin/env python3
"""unslop-scan — the mechanical half of /unslop.

  unslop-scan                  files changed vs HEAD (staged + unstaged + untracked)
  unslop-scan PATH...          those files or dirs
  unslop-scan --all PATH       run copy rules even on internal docs
  unslop-scan --fix PATH       apply the two safe character fixes, then rescan
  unslop-scan --passive PATH   add the noisy passive-voice pass
  unslop-scan --json           machine-readable

Masks code fences, inline code, URLs and link targets before matching, so a
rule never fires on an identifier. Internal docs (AGENTS.md, CLAUDE.md,
SKILL.md, .agents/**, code comments) get only the universal rules: voice rules
are for copy a reader sees.
"""
import json
import os
import re
import subprocess
import sys

# ---------------------------------------------------------------- rules
# (id, scope, hint, pattern)   scope: "copy" = reader-facing only, "any" = everywhere
RULES = [
    # -- universal: wrong in a README and wrong in an AGENTS.md alike
    ("chatbot", "any", "cut it",
     r"\b(I hope this helps|Let me know if|Feel free to|Happy to help|Great question|"
     r"You'?re absolutely right|Of course[!,]|Certainly[!,]|Absolutely[!]|Sure thing|"
     r"As an AI|I'?d be happy to|Hopefully this)\b"),
    ("sycophancy", "any", "answer, don't flatter",
     r"\b(Great|Excellent|Perfect|Fantastic|Good) (question|point|catch|idea|call)\b"),
    ("curly-quote", "any", "straight quotes (--fix)", "[‘’“”]"),
    ("nbsp", "any", "plain space (--fix)", " "),
    ("cutoff-disclaimer", "any", "find the source or cut",
     r"\b(While specific details are|Based on available information|"
     r"my (knowledge|training) (cutoff|data)|as of my last)\b"),

    # -- punctuation, copy only
    ("em-dash", "copy", "period, colon, semicolon, comma or ()", "—"),
    ("en-dash-as-dash", "copy", "same as em-dash", r"(?<=\s)–(?=\s)"),
    ("dash-substitute", "copy", "an em-dash in disguise", r"(?<=\s)--(?=\s)"),
    ("emoji-heading", "copy", "no decoration in headings",
     r"^#{1,6} .*[\U0001F300-\U0001FAFF☀-➿️]"),

    # -- shape, copy only
    ("title-case-heading", "copy", "sentence case", None),  # handled in code
    ("inline-header-list", "copy", "prose, or a period not a colon",
     r"^\s*[-*+] \*\*[^*\n]+:\*\*"),

    # -- vocabulary, copy only
    ("ai-vocab", "copy", "plain word",
     r"\b(additionally|crucial|delve|seamless(ly)?|robust|leverage[sd]?|leveraging|utiliz(e|es|ing)|"
     r"foster(s|ing|ed)?|garner(s|ed)?|interplay|intricate|pivotal|showcas(e|es|ing|ed)|tapestry|"
     r"testament|underscor(e|es|ing|ed)|vibrant|myriad|plethora|realm|embark|holistic|"
     r"comprehensive|versatile|cutting[- ]edge|state[- ]of[- ]the[- ]art|game[- ]chang\w+|"
     r"revolutioniz\w+|empower(s|ing|ed)?|streamlin(e|es|ing|ed)|elevat(e|es|ing)|"
     r"unlock(s|ing)? the|navigat(e|ing) the|in the (realm|world|landscape) of)\b"),
    ("abstract-noun", "copy", "name the concrete thing",
     r"\b(substrate|wedge|vector|locus|vantage|nexus|bedrock|modality|paradigm|"
     r"north star|flywheel|gold[- ]plating|endgame|(API|attack|design) surface|"
     r"(the|a|an) (landscape|ecosystem|tapestry) of)\b"),
    ("fancy-is", "copy", "is / has",
     r"\b(serves as|stands as|boasts|acts as|functions as|represents a|is designed to be)\b"),
    ("plain-word", "copy", "use the short one",
     r"\b(facilitat(e|es|ing)|numerous|in the event that|prior to|subsequent to|"
     r"in conjunction with|a variety of|a number of)\b"),

    # -- constructions, copy only
    ("not-just", "copy", "state the point",
     r"\b(not (just|only|merely) \w[^.\n]{0,60}?,? but|isn'?t just|more than just|"
     r"it'?s not (just|about) \w)"),
    ("puffery", "copy", "state what happened",
     r"\b(pivotal moment|testament to|evolving landscape|set(s|ting)? the stage|"
     r"indelible|deeply rooted|at the heart of|groundbreaking|breathtaking|stunning|"
     r"must[- ](have|visit|read)|world[- ]class|best[- ]in[- ]class|unparalleled|"
     r"nestled|renowned|beloved|iconic)\b"),
    ("vague-attribution", "copy", "name the source or cut",
     r"\b(experts? (say|believe|agree|suggest)|studies show|research suggests|"
     r"industry (reports?|leaders?|observers?)|it is widely (believed|considered)|"
     r"many believe|some (argue|say|critics)|it'?s (often|widely) said)\b"),
    ("filler", "copy", "delete",
     r"\b(in order to|due to the fact that|it (is|'?s) (important|worth) (to note|noting)|"
     r"it should be noted|needless to say|at the end of the day|when it comes to|"
     r"in today'?s \w+|that being said|first and foremost|the fact of the matter)\b"),
    ("hedge-stack", "copy", "one qualifier, max",
     r"\b(could|might|may|can) (potentially|possibly|perhaps|arguably|conceivably)\b"
     r"|\b(potentially|possibly|perhaps) (could|might|may)\b"
     r"|\b(somewhat|relatively|fairly|quite) (more|less|better|worse)\b"),
    ("generic-conclusion", "copy", "a fact or a plan instead",
     r"\b(the future (looks|is) \w+|exciting times|the possibilities are|"
     r"sky'?s the limit|only time will tell|one thing is (clear|certain)|"
     r"in conclusion|to sum up|ultimately,)\b"),
    ("formulaic-challenge", "copy", "the specific fact",
     r"\b[Dd]espite [^,.\n]{5,60}, [^.\n]{0,40}(continues? to|remains?|still)\b"),
    ("weak-adverb", "copy", "stronger verb, or the number",
     r"\b(significantly|dramatically|substantially|greatly|vastly|incredibly|"
     r"remarkably|notably) (improv|enhanc|increas|reduc|boost|speed|faster|better)\w*"),
]

PASSIVE = ("passive", "copy", "name the actor",
           r"\b(is|are|was|were|be|been|being) [a-z]+(ed|en)\b(?! by \w)")

UNIVERSAL = {r[0] for r in RULES if r[1] == "any"}

# --------------------------------------------------------------- scoping
INTERNAL_NAMES = {"AGENTS.md", "CLAUDE.md", "GEMINI.md", "SKILL.md", "ROUTINE.md",
                  "CONTRIBUTING.md", "TODO.md", "NOTES.md"}
INTERNAL_DIRS = (".agents/", ".claude/", ".codex/", ".opencode/", ".github/", "docs/adr/")
GENERATED = ("reference/options.mdx", "bar-tables.json", "/out/", "/dist/", "/.next/",
             "node_modules/", "flake.lock", "package-lock.json", "-lock.yaml", ".min.")
TEXT_EXT = {".md", ".mdx", ".txt", ".html", ".tsx", ".jsx", ".ts", ".js", ".json", ".yml", ".yaml"}
PROSE_EXT = {".md", ".mdx", ".txt", ".html"}

STOPWORDS = {"a", "an", "and", "as", "at", "but", "by", "for", "from", "in", "is", "it",
             "of", "on", "or", "the", "to", "up", "via", "with", "not", "no"}


def is_internal(path):
    base = os.path.basename(path)
    norm = "/" + path.replace(os.sep, "/")
    return base in INTERNAL_NAMES or any(d in norm for d in INTERNAL_DIRS)


def is_generated(path):
    norm = "/" + path.replace(os.sep, "/")
    return any(g in norm for g in GENERATED)


# ---------------------------------------------------------------- masking
FENCE = re.compile(r"^\s*(```|~~~)")
MASKS = [
    re.compile(r"`[^`\n]*`"),                 # inline code
    re.compile(r"\]\([^)\n]*\)"),             # link + image targets
    re.compile(r"<https?://[^>\n]*>"),        # autolinks
    re.compile(r"https?://\S+"),              # bare urls
    re.compile(r"^\s{4,}\S.*$"),              # indented code
    re.compile(r'\b\w+="[^"\n]*"'),           # html/jsx attributes
]


def prepare(text):
    """Blank out code and URLs, keeping line and column numbers intact."""
    out, in_fence = [], False
    for line in text.split("\n"):
        if FENCE.match(line):
            in_fence = not in_fence
            out.append("")
            continue
        if in_fence or line.lstrip().startswith(">"):
            out.append("")          # quotations keep their author's punctuation
            continue
        for m in MASKS:
            line = m.sub(lambda mo: " " * len(mo.group(0)), line)
        out.append(line)
    return out


def title_case_hits(lines):
    hits = []
    for n, line in enumerate(lines, 1):
        m = re.match(r"^(#{1,6}) +(.+?)\s*$", line)
        if not m:
            continue
        words = re.findall(r"[A-Za-z][A-Za-z'\-]*", m.group(2))
        if len(words) < 3:
            continue
        body = words[1:]
        cand = [w for w in body if w.lower() not in STOPWORDS]
        if len(cand) < 2 and not any(
                w.lower() in STOPWORDS and w[0].isupper() and not w.isupper() and w != "I"
                for w in body):
            continue
        capped = [w for w in cand if w[0].isupper()]
        # sentence case never capitalises "Up", "The", "Of" mid-heading
        stop_capped = [w for w in body if w.lower() in STOPWORDS and w[0].isupper()
                       and not w.isupper() and w != "I"]
        # all-caps acronyms and single-word product names are not title case
        tell = stop_capped or (len(capped) == len(cand)
                               and not all(w.isupper() for w in capped))
        if tell:
            hits.append((n, m.start(2) + 1, "title-case-heading", m.group(2)[:70],
                         "sentence case"))
    return hits


# ------------------------------------------------------------------ scan
def scan(path, run_copy, passive=False):
    try:
        with open(path, "r", encoding="utf-8", errors="replace") as fh:
            raw = fh.read()
    except (OSError, UnicodeError):
        return []
    prose = os.path.splitext(path)[1].lower() in PROSE_EXT
    lines = prepare(raw)
    rules = list(RULES) + ([PASSIVE] if passive and run_copy else [])
    hits = []
    for rid, scope, hint, pat in rules:
        if pat is None:
            continue
        if scope == "copy" and not run_copy:
            continue
        if rid in ("title-case-heading", "emoji-heading",
                   "inline-header-list") and not prose:
            continue
        rx = re.compile(pat, re.IGNORECASE if rid not in
                        ("chatbot", "sycophancy", "formulaic-challenge") else 0)
        multiline = rid in ("emoji-heading", "inline-header-list")
        for n, line in enumerate(lines, 1):
            if not line.strip():
                continue
            for mo in rx.finditer(line):
                if not mo.group(0).strip():
                    continue
                hits.append((n, mo.start() + 1, rid, mo.group(0)[:70], hint))
                if multiline:
                    break
    if run_copy and prose:
        hits.extend(title_case_hits(lines))
    return sorted(hits)


FIXES = [("‘", "'"), ("’", "'"), ("“", '"'), ("”", '"'),
         (" ", " ")]


def apply_fix(path):
    try:
        with open(path, "r", encoding="utf-8") as fh:
            before = fh.read()
    except (OSError, UnicodeError):
        return 0
    after, n = before, 0
    for a, b in FIXES:
        n += after.count(a)
        after = after.replace(a, b)
    if n:
        with open(path, "w", encoding="utf-8") as fh:
            fh.write(after)
    return n


# ----------------------------------------------------------------- input
def changed_files():
    try:
        root = subprocess.run(["git", "rev-parse", "--show-toplevel"],
                              capture_output=True, text=True, check=True).stdout.strip()
        out = subprocess.run(["git", "-C", root, "status", "--porcelain", "-uall"],
                             capture_output=True, text=True, check=True).stdout
    except (subprocess.CalledProcessError, FileNotFoundError):
        return []
    files = []
    for line in out.splitlines():
        p = line[3:].strip()
        if " -> " in p:
            p = p.split(" -> ", 1)[1]
        files.append(os.path.join(root, p.strip('"')))
    return files


def walk(paths):
    files = []
    for p in paths:
        if os.path.isdir(p):
            for dirpath, dirnames, names in os.walk(p):
                dirnames[:] = [d for d in dirnames
                               if d not in {".git", "node_modules", "out", "dist", ".next"}]
                files += [os.path.join(dirpath, n) for n in names]
        else:
            files.append(p)
    return files


def main():
    argv = sys.argv[1:]
    flags = {a for a in argv if a.startswith("--")}
    paths = [a for a in argv if not a.startswith("--")]
    force_all, do_fix = "--all" in flags, "--fix" in flags
    passive, as_json = "--passive" in flags, "--json" in flags

    candidates = walk(paths) if paths else changed_files()
    targets = [f for f in candidates
               if os.path.isfile(f)
               and os.path.splitext(f)[1].lower() in TEXT_EXT
               and not is_generated(f)]

    if not targets:
        print("nothing to scan (no changed text files, or every match was generated)")
        return 0

    fixed = sum(apply_fix(f) for f in targets) if do_fix else 0

    results, counts = {}, {}
    for f in targets:
        run_copy = force_all or not is_internal(f)
        hits = [h for h in scan(f, run_copy, passive)
                if run_copy or h[2] in UNIVERSAL]
        if hits:
            results[f] = hits
            for h in hits:
                counts[h[2]] = counts.get(h[2], 0) + 1

    if as_json:
        print(json.dumps({"files": {k: [dict(zip(
            ("line", "col", "rule", "text", "hint"), h)) for h in v]
            for k, v in results.items()}, "counts": counts, "fixed": fixed}, indent=1))
        return 1 if results else 0

    cwd = os.getcwd() + os.sep
    for f, hits in sorted(results.items()):
        shown = f[len(cwd):] if f.startswith(cwd) else f
        tag = "" if (force_all or not is_internal(f)) else "  (internal: universal rules only)"
        print(f"\n\033[1m{shown}\033[0m{tag}")
        for n, col, rid, text, hint in hits[:14]:
            print(f"  {n:>5}  {rid:<20} {text!r:<44} -> {hint}")
        if len(hits) > 14:
            print(f"         ... {len(hits) - 14} more in this file")

    total = sum(counts.values())
    if fixed:
        print(f"\nfixed {fixed} character-level tells (curly quotes, nbsp)")
    if not total:
        print(f"\nclean: {len(targets)} file(s), no mechanical tells")
        return 0
    order = " · ".join(f"{k} {v}" for k, v in sorted(counts.items(), key=lambda x: -x[1]))
    print(f"\n{total} hits in {len(results)} of {len(targets)} file(s)\n  {order}")
    print("\nMechanical only. The judgment pass (voice, rhythm, specificity) is yours.")
    return 1


if __name__ == "__main__":
    sys.exit(main())
